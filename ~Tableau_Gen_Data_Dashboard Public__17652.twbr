      <aliases enabled='yes' />
      <column caption='Profit Margin' datatype='real' default-format='p0.00%' name='[Calculation_0426127517728769]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([gross_profit]) / SUM([Sales Amount])' />
      </column>
      <column caption='Return Rate' datatype='real' default-format='p0%' name='[Calculation_0426127517908994]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Qty Sold] &lt; 0 THEN ABS([Qty Sold]) END) / SUM(IF [Qty Sold] &gt; 0 THEN [Qty Sold] END)' />
      </column>
